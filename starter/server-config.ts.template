import "server-only";
import { z } from "zod";

const booleanString = z.enum(["true", "false"]).transform((value) => value === "true");

const schema = z.object({
  NODE_ENV: z.enum(["development", "test", "production"]),
  NEXT_PUBLIC_SITE_URL: z.string().url(),
  NEXT_PUBLIC_SUPABASE_URL: z.string().url(),
  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: z.string().min(20),
  SUPABASE_SERVICE_ROLE_KEY: z.string().min(20).optional(),
  DISABLE_PAYMENTS: booleanString.default("true"),
  DISABLE_DOCUMENT_UPLOADS: booleanString.default("true"),
  DISABLE_AI_ASSISTANT: booleanString.default("true"),
  DISABLE_COMMUNITY: booleanString.default("true"),
  DISABLE_APPOINTMENTS: booleanString.default("true"),
  DISABLE_PUBLIC_INTAKE: booleanString.default("true"),
  STRIPE_SECRET_KEY: z.string().min(20).optional(),
  STRIPE_WEBHOOK_SECRET: z.string().min(20).optional(),
  CRM_ENCRYPTION_KEY_V1: z.string().min(43).optional(),
  CRM_BLIND_INDEX_KEY_V1: z.string().min(43).optional(),
  MALWARE_SCANNER_URL: z.string().url().optional(),
  MALWARE_SCANNER_TOKEN: z.string().min(20).optional(),
  OPENAI_API_KEY: z.string().min(20).optional()
});

const parsed = schema.parse(process.env);

function requireWhen(enabled: boolean, names: Array<keyof typeof parsed>): void {
  if (!enabled) return;
  for (const name of names) {
    if (!parsed[name]) throw new Error(`Feature enabled without ${String(name)}`);
  }
}

requireWhen(!parsed.DISABLE_PAYMENTS, ["STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET"]);
requireWhen(!parsed.DISABLE_DOCUMENT_UPLOADS, ["MALWARE_SCANNER_URL", "MALWARE_SCANNER_TOKEN"]);
requireWhen(!parsed.DISABLE_PUBLIC_INTAKE, ["CRM_ENCRYPTION_KEY_V1", "CRM_BLIND_INDEX_KEY_V1"]);
requireWhen(!parsed.DISABLE_AI_ASSISTANT, ["OPENAI_API_KEY"]);

export const serverConfig = Object.freeze(parsed);
