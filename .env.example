# Copy to .env.local. Never commit values.
NODE_ENV=development

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase server-only
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Used only by local Supabase; never expose it in Vercel client variables.
SUPABASE_AUTH_CAPTCHA_SECRET=

# Feature flags can also live in DB. Env kill switches override DB.
DISABLE_PAYMENTS=true
DISABLE_DOCUMENT_UPLOADS=true
DISABLE_AI_ASSISTANT=true
DISABLE_COMMUNITY=true
DISABLE_APPOINTMENTS=true
DISABLE_PUBLIC_INTAKE=true
DISABLE_WHATSAPP=true
DISABLE_COURSES=true
DISABLE_PROFESSIONAL_PORTAL=true
DISABLE_PUBLIC_REGISTRATION=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=

# Application crypto: 32+ random bytes, base64url. Separate per purpose/environment.
CRM_ENCRYPTION_KEY_V1=
CRM_BLIND_INDEX_KEY_V1=
APP_SIGNING_KEY=
MEETING_URL_ENCRYPTION_KEY_V1=
DOCUMENT_METADATA_ENCRYPTION_KEY_V1=
CRON_SECRET=

# Email
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Malware scanner
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_TIMEOUT_MS=30000

# AI
OPENAI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_DAILY_USER_LIMIT=20
AI_MONTHLY_BUDGET_USD=0

# Meeting provider
MEETING_PROVIDER=manual
MEETING_PROVIDER_CLIENT_ID=
MEETING_PROVIDER_CLIENT_SECRET=
MEETING_PROVIDER_WEBHOOK_SECRET=

# Observability
OBSERVABILITY_DSN=
LOG_LEVEL=info

# One-time admin bootstrap. Keep in an external chmod 600 file and delete after use.
ALLOW_ADMIN_BOOTSTRAP=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
EXPECTED_SUPABASE_PROJECT_REF=
ALLOW_ADDITIONAL_SUPER_ADMIN=false
