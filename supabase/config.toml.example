# Run `supabase init` with the current CLI and merge these intentions.
project_id = "haitian-legal-travel-platform"

[api]
enabled = true
schemas = ["public"]
extra_search_path = ["public", "extensions"]
max_rows = 1000

# Keep the [db] version generated by the installed Supabase CLI.
# Do not hardcode a PostgreSQL major from this handoff template.

[db.seed]
enabled = true
sql_paths = ["./seed.sql"]

[auth]
enabled = true
site_url = "http://localhost:3000"
additional_redirect_urls = ["http://localhost:3000/**"]
jwt_expiry = 3600
enable_signup = true
enable_anonymous_sign_ins = false
minimum_password_length = 12

[auth.email]
enable_signup = true
double_confirm_changes = true
enable_confirmations = true
secure_password_change = true

[storage]
enabled = true
file_size_limit = "10MiB"

# Codex: generate the final file with the installed CLI. Do not blindly copy
# options that changed. Configure CAPTCHA, rate limits and SMTP in local/remote.
