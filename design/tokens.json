{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "status": "provisional",
    "note": "Replace with approved brand without changing semantic aliases."
  },
  "color": {
    "brand": {
      "50": { "$value": "#F2F7F6", "$type": "color" },
      "100": { "$value": "#DCEBE7", "$type": "color" },
      "500": { "$value": "#176B5B", "$type": "color" },
      "700": { "$value": "#0E4A3E", "$type": "color" },
      "900": { "$value": "#082E27", "$type": "color" }
    },
    "accent": {
      "500": { "$value": "#C67924", "$type": "color" },
      "700": { "$value": "#895016", "$type": "color" }
    },
    "neutral": {
      "0": { "$value": "#FFFFFF", "$type": "color" },
      "50": { "$value": "#F7F8F8", "$type": "color" },
      "200": { "$value": "#D9DEDC", "$type": "color" },
      "700": { "$value": "#37413E", "$type": "color" },
      "900": { "$value": "#151A18", "$type": "color" }
    },
    "semantic": {
      "text": { "$value": "{color.neutral.900}", "$type": "color" },
      "mutedText": { "$value": "{color.neutral.700}", "$type": "color" },
      "background": { "$value": "{color.neutral.0}", "$type": "color" },
      "surface": { "$value": "{color.neutral.50}", "$type": "color" },
      "primary": { "$value": "{color.brand.700}", "$type": "color" },
      "focus": { "$value": "#005FCC", "$type": "color" },
      "danger": { "$value": "#9C1C1C", "$type": "color" },
      "warning": { "$value": "#7A4B00", "$type": "color" },
      "success": { "$value": "#17613A", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "var(--font-sans), system-ui, sans-serif", "$type": "fontFamily" }
    },
    "size": {
      "body": { "$value": "1.125rem", "$type": "dimension" },
      "small": { "$value": "1rem", "$type": "dimension" },
      "h1": { "$value": "clamp(2.25rem, 7vw, 4.5rem)", "$type": "dimension" },
      "h2": { "$value": "clamp(1.75rem, 4vw, 3rem)", "$type": "dimension" }
    },
    "lineHeight": {
      "body": { "$value": 1.65, "$type": "number" },
      "heading": { "$value": 1.1, "$type": "number" }
    }
  },
  "space": {
    "1": { "$value": "0.25rem", "$type": "dimension" },
    "2": { "$value": "0.5rem", "$type": "dimension" },
    "3": { "$value": "0.75rem", "$type": "dimension" },
    "4": { "$value": "1rem", "$type": "dimension" },
    "6": { "$value": "1.5rem", "$type": "dimension" },
    "8": { "$value": "2rem", "$type": "dimension" },
    "12": { "$value": "3rem", "$type": "dimension" },
    "16": { "$value": "4rem", "$type": "dimension" }
  },
  "radius": {
    "control": { "$value": "0.75rem", "$type": "dimension" },
    "card": { "$value": "1.25rem", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "size": {
    "touchTargetMinimum": { "$value": "44px", "$type": "dimension" },
    "touchTargetPreferred": { "$value": "48px", "$type": "dimension" },
    "contentMax": { "$value": "72rem", "$type": "dimension" },
    "readingMax": { "$value": "44rem", "$type": "dimension" }
  }
}
