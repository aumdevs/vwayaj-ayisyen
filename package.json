{
  "name": "vwayaj-ayisyen",
  "version": "0.1.0",
  "private": true,
  "description": "Sit entènèt ofisyèl Vwayaj Ayisyen.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.15.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "visual:capture": "node scripts/capture-pwa-acceptance.mjs",
    "check:env": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/verify-env.mjs",
    "check:secrets": "bash scripts/check-no-secrets.sh",
    "integrity:check": "node scripts/refresh-package-integrity.mjs --check",
    "integrity:refresh": "node scripts/refresh-package-integrity.mjs",
    "check:all": "pnpm format:check && pnpm integrity:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:secrets",
    "audit:prod": "pnpm audit --prod",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level warning",
    "db:test": "supabase test db",
    "db:types": "bash scripts/generate-supabase-types.sh --local",
    "db:types:remote": "bash scripts/generate-supabase-types.sh",
    "admin:bootstrap": "node --env-file=.env.bootstrap.local --import tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@marsidev/react-turnstile": "1.5.3",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "lucide-react": "1.25.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.82.0",
    "server-only": "0.0.1",
    "stripe": "22.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
