{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment variable presence schema",
  "type": "object",
  "properties": {
    "NODE_ENV": { "enum": ["development", "test", "production"] },
    "NEXT_PUBLIC_SITE_URL": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "NEXT_PUBLIC_SUPABASE_URL": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": { "type": "string", "minLength": 20 },
    "SUPABASE_SERVICE_ROLE_KEY": { "type": "string", "minLength": 20 },
    "STRIPE_SECRET_KEY": { "type": "string", "minLength": 20 },
    "STRIPE_WEBHOOK_SECRET": { "type": "string", "minLength": 20 },
    "CRM_ENCRYPTION_KEY_V1": { "type": "string", "minLength": 43 },
    "CRM_BLIND_INDEX_KEY_V1": { "type": "string", "minLength": 43 },
    "APP_SIGNING_KEY": { "type": "string", "minLength": 43 },
    "CRON_SECRET": { "type": "string", "minLength": 43 },
    "EMAIL_PROVIDER_API_KEY": { "type": "string", "minLength": 1 },
    "EMAIL_FROM": { "type": "string", "format": "email" },
    "OPENAI_API_KEY": { "type": "string", "minLength": 20 },
    "AI_MODEL": { "type": "string", "minLength": 1 },
    "MALWARE_SCANNER_URL": { "type": "string", "format": "uri" },
    "MALWARE_SCANNER_TOKEN": { "type": "string", "minLength": 20 },
    "OBSERVABILITY_DSN": { "type": "string", "minLength": 1 },
    "BOOTSTRAP_ADMIN_EMAIL": { "const": "admin@aumprodz.com" },
    "BOOTSTRAP_ADMIN_PASSWORD": { "type": "string", "minLength": 32 },
    "ALLOW_ADMIN_BOOTSTRAP": { "enum": ["true", "false"] }
  },
  "required": [
    "NODE_ENV",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
  ],
  "additionalProperties": true
}
